    {
      "name": "messagebox",
      "library": "Miscellaneous",
      "executors": ["potassium", "volt", "wave"],
      "signature": "messagebox(text: string, caption: string, flags: number): number",
      "description": "Creates a native OS message box.",
      "parameters": [
        { "name": "text", "type": "string", "description": "Message box content" },
        { "name": "caption", "type": "string", "description": "Message box title" },
        { "name": "flags", "type": "number", "description": "Button flags (0=OK, 4=Yes/No, etc)" }
      ],
      "returns": [
        { "type": "number", "description": "Result clicked (1=OK, 6=Yes, 7=No)" }
      ],
      "example": "local res = messagebox('Are you sure?', 'Warning', 4)",
      "notes": "Wave alias: messageboxasync",
      "seeAlso": []
