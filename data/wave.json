{
  "functions": [
    {
      "name": "decompile",
      "library": "Miscellaneous",
      "executors": ["potassium", "volt", "sunc", "wave"],
      "signature": "decompile(script: Instance): string",
      "description": "Decompiles a LocalScript or ModuleScript and returns the decompiled output.",
      "parameters": [
        { "name": "script", "type": "Instance", "description": "The script to decompile" }
      ],
      "returns": [
        { "type": "string", "description": "Decompiled Lua source code" }
      ],
      "example": "local src = decompile(game.Players.LocalPlayer.PlayerScripts.PlayerModule)",
      "notes": "Premium only function in Wave. May fail on obfuscated scripts.",
      "seeAlso": ["saveinstance"]
    },
    {
      "name": "saveinstance",
      "library": "Miscellaneous",
      "executors": ["potassium", "volt", "sunc", "wave"],
      "signature": "saveinstance(Object: Instance?, FilePath: string?, Options: table?): void",
      "description": "Saves the current game or specific object to a .RBXL or .RBXM file.",
      "parameters": [
        { "name": "Object", "type": "Instance", "description": "Object to save (optional)" },
        { "name": "FilePath", "type": "string", "description": "Output path (optional)" },
        { "name": "Options", "type": "table", "description": "Save options (Decompile, NilInstances, etc.)" }
      ],
      "returns": [],
      "example": "saveinstance(workspace.CoolModel, 'Cool Model', { Decompile = true })",
      "notes": "Options table takes: Decompile, DecompileTimeout, DecompileIgnore, NilInstances, MaxThreads, ShowStatus.",
      "seeAlso": ["decompile"]
    },
