      "executors": ["potassium", "volt"],
      "signature": "create_comm_channel(): (string, BindableEvent)",
      "description": "Returns an identifier and a BindableEvent. Used in one-way communication between actors.",
      "parameters": [],
      "returns": [
        { "type": "string", "description": "Channel identifier" },
        { "type": "BindableEvent", "description": "Communication event" }
      ],
      "example": "local id, event = create_comm_channel()",
      "notes": "Potassium/Volt specific for actor communication.",
      "seeAlso": ["get_comm_channel"]
    },
    {
