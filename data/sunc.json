    {
      "name": "hookfunction",
      "library": "Closure",
      "executors": [
        "potassium",
        "volt",
        "sunc",
        "wave"
      ],
      "signature": "hookfunction(func: function, hook: function): function",
      "description": "Hooks a Lua or C function. Returns a copy of the original function.",
      "parameters": [
        {
          "name": "func",
          "type": "function",
          "description": "The function to hook"
        },
        {
          "name": "hook",
          "type": "function",
          "description": "The replacement function"
        }
      ],
      "returns": [
        {
          "type": "function",
          "description": "Original function copy"
        }
      ],
      "example": "local oldPrint = hookfunction(print, function(...)\n\trconsoleprint('[hooked] ')\n\treturn oldPrint(...)\nend)",
      "notes": "Always call the original to avoid breaking game logic.",
      "seeAlso": [
        "restorefunction",
        "isfunctionhooked",
        "newcclosure"
      ]
    },
    {
      "name": "iscclosure",
