    {
      "name": "raknet.add_send_hook",
      "library": "RakNet",
      "executors": ["potassium", "volt"],
      "signature": "raknet.add_send_hook(hook: function): function",
      "description": "Registers a callback that runs before a RakNetPacket is sent.",
      "parameters": [
        { "name": "hook", "type": "function", "description": "Callback(packet)" }
      ],
      "returns": [
        { "type": "function", "description": "Hook connection" }
      ],
      "example": "raknet.add_send_hook(function(packet)\n  if packet.data[1] == 0x83 then return false end\nend)",
      "notes": "Returning false blocks the packet.",
      "seeAlso": ["raknet.remove_send_hook"]
    },
    {
      "name": "raknet.remove_send_hook",
      "library": "RakNet",
      "executors": ["potassium", "volt"],
      "signature": "raknet.remove_send_hook(hook: function): void",
      "description": "Removes a previously registered send hook.",
      "parameters": [
        { "name": "hook", "type": "function", "description": "The registered hook" }
      ],
      "returns": [],
      "example": "raknet.remove_send_hook(myHook)",
      "notes": "",
      "seeAlso": ["raknet.add_send_hook"]
    },
