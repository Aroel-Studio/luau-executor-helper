      "signature": "cache.replace(obj: Instance, new_obj: Instance): void",
      "description": "Replaces an instance in the cache with a different instance.",
      "parameters": [
        { "name": "obj", "type": "Instance", "description": "Original instance" },
        { "name": "new_obj", "type": "Instance", "description": "New instance" }
      ],
      "returns": [],
      "example": "cache.replace(workspace.Part, workspace.OtherPart)",
      "notes": "Useful for tricking scripts that index the cache.",
      "seeAlso": ["cache.invalidate"]
    },
