    {
      "name": "oth.hook",
      "library": "OTH",
      "executors": ["potassium", "volt"],
      "signature": "oth.hook(func: function, hook: function): function",
      "description": "Hooks a function by utilizing a secure Off-Thread execution model.",
      "parameters": [
        { "name": "func", "type": "function", "description": "Function to hook" },
        { "name": "hook", "type": "function", "description": "Hook function" }
      ],
      "returns": [
        { "type": "function", "description": "Original function" }
      ],
      "example": "local old\nold = oth.hook(print, function(...) old(...) end)",
      "notes": "Highly secure for C closures.",
      "seeAlso": ["oth.unhook", "hookfunction"]
    },
